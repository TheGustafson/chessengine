+/// Software prefetch of the first `LINES` cache lines of a feature-transformer
+/// weight row, issued at the moment the row's INDEX becomes known rather than
+/// at the moment the fold reaches it.
+///
+/// Why a helper and not an intrinsic at each site: the useful window is not
+/// inside the kernel. Within one `apply_*_deltas_into` call the four row
+/// streams are already independent loads inside one out-of-order window, so
+/// the hardware overlaps them without help — which is why perf study #4's
+/// in-kernel row prefetch measured a loss and stayed out. The window that the
+/// hardware CANNOT cover is the one BETWEEN folds: perspective 1's rows during
+/// perspective 0's fold, and the FullThreats rows during both HalfKA folds.
+/// Those are separated by hundreds of retired instructions and two function
+/// calls — far past the ~320-uop reorder buffer. This helper exists to be
+/// called from the resolve sites, not from the kernels.
+///
+/// `LINES` is a const generic so the loop is fully unrolled into `LINES`
+/// `prefetcht0`s with no counter. Two lines is the measured sweet spot: enough
+/// to trigger the L2 stride prefetcher on the rest of the (1280 B or 2560 B)
+/// row, cheap enough that 16 of them per node do not displace live L1 lines.
+///
+/// # A SAFE signature, deliberately
+/// The interface is `(table, element_offset)` rather than a raw pointer, and
+/// the offset is applied with [`pointer::wrapping_add`]. That is what keeps
+/// the `unsafe` inside this one function instead of spreading an `unsafe`
+/// block to every call site (`lib.rs` denies `unsafe_code` crate-wide, D14):
+/// `wrapping_add` is defined for ANY offset, and `_mm_prefetch` neither
+/// dereferences nor faults on any address, so a caller cannot make this
+/// unsound however wrong its index is. Callers still pass in-bounds rows —
+/// a hint on a foreign page just wastes a TLB slot — but correctness does not
+/// depend on it, which is the property worth having in a perf experiment.
+#[allow(unsafe_code)]
+#[inline(always)]
+pub(crate) fn prefetch_row<const LINES: usize, T>(table: &[T], offset: usize) {
+    #[cfg(target_arch = "x86_64")]
+    {
+        use core::arch::x86_64::{_MM_HINT_T0, _mm_prefetch};
+        let base = table.as_ptr().wrapping_add(offset).cast::<i8>();
+        for k in 0..LINES {
+            // SAFETY: `_mm_prefetch` is a pure hint — it does not access
+            // memory, cannot fault, and has no defined effect other than on
+            // the cache. `wrapping_add` above is defined for every offset, so
+            // there is no out-of-bounds pointer arithmetic to justify either.
+            unsafe { _mm_prefetch(base.wrapping_add(k * 64), _MM_HINT_T0) };
+        }
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    {
+        let _ = (table, offset);
+    }
+}
