+pub static CNT_TABLES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_ROOK: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_BISHOP: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_MAKE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_UNMAKE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_ATTACKERS_TO: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_ATT_EXIST: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_SETCHECK: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_TP_FROM_BOARD: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static CNT_BETWEEN: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+/// PERFCOUNT13: dump every counter, normalised per node.
+pub fn perfcount13_dump(nodes: u64, out: &mut impl std::io::Write) -> std::io::Result<()> {
+    use std::sync::atomic::Ordering::Relaxed;
+    let n = nodes.max(1) as f64;
+    for (name, c) in [
+        ("tables()", &CNT_TABLES),
+        ("rook_attacks", &CNT_ROOK),
+        ("bishop_attacks", &CNT_BISHOP),
+        ("make_move", &CNT_MAKE),
+        ("unmake_move", &CNT_UNMAKE),
+        ("attackers_to", &CNT_ATTACKERS_TO),
+        ("attackers_to_exist", &CNT_ATT_EXIST),
+        ("set_check_info", &CNT_SETCHECK),
+        ("ThreatPosition::from_board", &CNT_TP_FROM_BOARD),
+        ("between()", &CNT_BETWEEN),
+    ] {
+        let v = c.load(Relaxed);
+        writeln!(out, "PERFCOUNT13 {name:<28} {v:>14} {:>10.4}/node", v as f64 / n)?;
+    }
+    Ok(())
+}
