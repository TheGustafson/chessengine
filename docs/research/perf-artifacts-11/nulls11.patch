 /// a shift. Same row, same arithmetic, bit-identical output.
 #[inline]
 fn psqt_row(table: &[i32], feature: usize) -> &[i32; BUCKETS] {
+    &psqt_rows(table)[feature]
+}
+
+/// The PSQ1 table viewed as what it structurally IS — a slice of `BUCKETS`-wide
+/// rows — so a caller that resolves MANY features against ONE table performs the
+/// reshape once instead of once per feature.
+///
+/// Perf study 11: `psqt_row` was called from inside the threat resolver's
+/// per-event loop, so every event-perspective re-ran `as_chunks` — which is a
+/// length division (a shift) plus the slice reconstruction — for a table that is
+/// invariant across the whole fold. Hoisting it to the loop's caller is a
+/// source-level change LLVM will not make, because `psqt_table` arrives as a
+/// plain `&[i32]` whose length it cannot prove loop-invariant against the
+/// `&mut` accumulator writes in the same body.
+///
+/// `as_chunks` (stable since 1.88) returns `(&[[T; N]], &[T])`; the tail is
+/// empty by construction here — both tables are an exact multiple of `BUCKETS`
+/// (`THREAT_DIMS · BUCKETS` / `HALFKA_DIMS · BUCKETS`) — and dropping it is what
+/// states the row shape to the optimizer.
+#[inline]
+pub(crate) fn psqt_rows(table: &[i32]) -> &[[i32; BUCKETS]] {
     let (rows, _tail) = table.as_chunks::<BUCKETS>();
-    &rows[feature]
+    rows
+}
+
+/// [`psqt_add`] against a pre-reshaped table (see [`psqt_rows`]).
+#[inline]
+pub(crate) fn psqt_add_row(psqt: &mut [i32; BUCKETS], rows: &[[i32; BUCKETS]], feature: usize) {
+    for (a, &w) in psqt.iter_mut().zip(&rows[feature]) {
+        *a += w;
+    }
+}
+
+/// [`psqt_sub`] against a pre-reshaped table (see [`psqt_rows`]).
+#[inline]
+pub(crate) fn psqt_sub_row(psqt: &mut [i32; BUCKETS], rows: &[[i32; BUCKETS]], feature: usize) {
+    for (a, &w) in psqt.iter_mut().zip(&rows[feature]) {
+        *a -= w;
+    }
 }
 
