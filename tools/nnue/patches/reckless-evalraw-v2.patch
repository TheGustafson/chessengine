+fn eval_raw(td: &mut ThreadData, board: &Board) {
+    td.nnue.full_refresh(board);
+    let raw = td.nnue.evaluate(board);
+    // This is the deterministic cold static evaluator: no correction-history
+    // term and no search-derived optimism.  Keep the raw NNUE units as a
+    // separate field so consumers never mistake them for UCI centipawns.
+    let material = board.material();
+    let mut static_internal = raw * (21032 + material) / 27015;
+    static_internal = static_internal * (200 - board.fiftymove_clock() as i32) / 200;
+    static_internal = static_internal.clamp(-Score::TB_WIN_IN_MAX + 1, Score::TB_WIN_IN_MAX - 1);
+    println!(
+        "evalraw status=ok raw_nnue_units={raw} static_internal={static_internal} rule50={}",
+        board.fiftymove_clock()
+    );
+}
