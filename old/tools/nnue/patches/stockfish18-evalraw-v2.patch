 }
 
+void Engine::raw_eval() const {
+    StateListPtr raw_states(new std::deque<StateInfo>(1));
+    Position     p;
+    p.set(pos.fen(), options["UCI_Chess960"], &raw_states->back());
+
+    verify_networks();
+    if (p.checkers())
+    {
+        sync_cout << "evalraw status=invalid_check" << sync_endl;
+        return;
+    }
+
+    auto accumulators = std::make_unique<Eval::NNUE::AccumulatorStack>();
+    auto caches       = std::make_unique<Eval::NNUE::AccumulatorCaches>(*networks);
+    auto [psqt, positional] = networks->big.evaluate(p, *accumulators, caches->big);
+    Value bigSum            = psqt + positional;
+    Value finalValue = Eval::evaluate(*networks, p, *accumulators, *caches, VALUE_ZERO);
+    sync_cout << "evalraw status=ok"
+              << " final_internal=" << int(finalValue)
+              << " final_uci_cp=" << UCIEngine::to_cp(finalValue, p)
+              << " big_psqt_internal=" << int(psqt)
+              << " big_positional_internal=" << int(positional)
+              << " big_sum_internal=" << int(bigSum)
+              << " big_sum_uci_cp=" << UCIEngine::to_cp(bigSum, p)
+              << " rule50=" << p.rule50_count() << sync_endl;
+}
+
 const OptionsMap& Engine::get_options() const { return options; }
 OptionsMap&       Engine::get_options() { return options; }
 
