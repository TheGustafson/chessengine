+/// Train while keeping complete named tensors bit-identical.
+///
+/// Frozen weights remain present in the forward graph, but autograd does not
+/// materialise their gradients and the optimiser never updates them.  This is
+/// useful for protected teacher trunks and adapters; freezing tensor slices is
+/// deliberately out of scope.
+pub fn train_frozen<G: Gpu, O: OptimiserState<G>>(
+    optimiser: &mut Optimiser<G, O>,
+    schedule: TrainingSchedule,
+    dataloader: impl DataLoader,
+    frozen_names: &BTreeSet<String>,
