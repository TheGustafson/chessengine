+/// bit-identical to unpatched behavior.
+static SCORE_DIV: std::sync::LazyLock<f32> = std::sync::LazyLock::new(|| {
+    let div = std::env::var("SFBINPACK_SCORE_DIV").ok().and_then(|v| v.parse().ok()).unwrap_or(1.0);
+    if div != 1.0 {
+        println!("SF binpack score divisor: {div}");
