+    let mut board = ChessBoard::from_raw(bbs, stm, score, result).expect("Binpack must be malformed!");
+    // ARCHON D41 policy head: pack the teacher's best move (stm-relative from/to
+    // squares) into the two unused `ChessBoard.extra` bytes so the trainer's mapper
+    // can build a policy target. The ChessBoard layout/size is UNCHANGED (extra was
+    // already reserved) and features come from `pcs`/`occ`, so value training is
+    // byte-identical — the extra bytes are inert unless a policy head reads them.
+    //
+    // TARGET FRAME (the exp-0121 "_hm orient" fix, 2026-07-21): the squares are
+    // packed in the TRUNK's normalized frame, not just the mover's frame —
+    // (1) vertical flip (^56) for black to move (stm perspective), THEN
+    // (2) horizontal mirror (^7) when the stm king sits on files a-d, matching
+    // the engine's `orient_halfka` polarity exactly (file is invariant under
+    // ^56, so the raw king file decides). Without (2), positions the HalfKAv2_hm
+    // trunk mirrors get targets in the wrong frame — irreducible label noise on
+    // ~half the corpus, the failure exp-0121's post-mortem flagged.
+    let flip = if stm > 0 { 56u8 } else { 0u8 };
+    let ksq = entry.pos.king_sq(entry.pos.side_to_move());
+    let hflip = if (ksq.index() % 8) <= 3 { 7u8 } else { 0u8 };
+    let orient = flip ^ hflip;
